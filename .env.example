# ==========================================
# IRIS AI (chat) - unchanged from iris-ai/.env
# ==========================================

# =================================
# IRIS AI DATABASE
# =================================

DB_SERVER=
DB_NAME=Safe-Fare-Python
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# =================================
# EXISTING JAVA APPLICATION
# =================================

SAFEFARE_DB_NAME=Safe-Fare
SAFEFARE_DB_USERNAME=
SAFEFARE_DB_PASSWORD=

# Existing Java API
SAFEFARE_API_BASE_URL=http://185.193.19.156:9096

# =================================
# GEMINI
# =================================

GROQ_API_KEY=

# =================================
# APPLICATION
# =================================

APP_NAME=Iris AI
DEBUG=True


SAFEFARE_DB_NAME=Safe-Fare-Python
SAFEFARE_DB_USERNAME=
SAFEFARE_DB_PASSWORD=

# ==========================================
# IoT SENSOR backend - from SENSOR/backend/.env
# (DB_* renamed to SENSOR_DB_* - different database)
# ==========================================

# ==================================================
# AWS S3 CONFIGURATION
# ==================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

S3_BUCKET_NAME=
S3_FOLDER=test-backend/


# ==================================================
# MICROSOFT SQL SERVER 2022 CONFIGURATION
# ==================================================

SENSOR_DB_SERVER=
SENSOR_DB_NAME=Safe-Fare
SENSOR_DB_USERNAME=
SENSOR_DB_PASSWORD=

SENSOR_DB_DRIVER=ODBC Driver 18 for SQL Server
SENSOR_DB_TRUST_SERVER_CERTIFICATE=yes


# ==================================================
# SENSOR INGESTION CONFIGURATION
# ==================================================

S3_POLL_INTERVAL=5
TIMEZONE=Asia/Kolkata


# ==================================================
# SENSOR ALERT CONFIGURATION
# ==================================================

ALERT_EMAIL=


# ==================================================
# EMAIL SMTP CONFIGURATION (GMAIL)
# ==================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true


# ==================================================
# TYRE MAINTENANCE
# ==================================================
SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server,1433;DATABASE=Safe-Fare;UID=;PWD=;TrustServerCertificate=yes;
TYRE_MAINTENANCE_CHECK_INTERVAL=5
TYRE_OVERDUE_REMINDER_INTERVAL_HOURS=24

# ==================================================
# VEHICLE MAINTENANCE
# ==================================================
VM_DB_SERVER=
VM_DB_DATABASE=Safe-Fare
VM_DB_USERNAME=
VM_DB_PASSWORD=
VM_DB_PORT=1433
VM_DB_DRIVER=ODBC Driver 18 for SQL Server
VM_DB_ENCRYPT=yes
VM_DB_TRUST_SERVER_CERTIFICATE=yes
VM_DB_SCHEMA=dbo
VM_DB_CONNECT_TIMEOUT=15
VM_DB_LOCK_TIMEOUT_MS=10000
VM_APP_TIMEZONE=Asia/Kolkata
VM_DB_TIMESTAMPS_UTC=false
VM_VEHICLES_TABLE=vehicles
VM_DEFAULT_WINDOW_DAYS=30
VM_TENANT_WINDOWS=
VM_MAX_REASON_LENGTH=500
VM_MAX_PAGE_SIZE=100
VM_DRIVER_CAN_POSTPONE=true
VM_SCHEDULER_ENABLED=true
VM_SCHEDULER_RUN_AT=08:00
VM_SCHEDULER_RUN_ON_STARTUP=false
VM_OVERDUE_REMINDER_EVERY_DAYS=1
VM_NOTIFY_FLEET_OWNER=false

# Dev-only pretend login for /api/vehicle-maintenance (remove DEV_TENANT_ID before deploying)
DEV_TENANT_ID=1
DEV_ROLE=fleet_owner
DEV_USER_ID=owner-1


# =============================================================
# LOCAL TESTING / FASTAPI
# =============================================================
# Leave EMPTY on your PC so Swagger is at http://127.0.0.1:8000/docs.
# On the server (behind the proxy) set:  ROOT_PATH=/safe-fare-python
ROOT_PATH=
# Extra browser origins allowed by CORS, comma separated (localhost:3000/5173/8000 are already allowed)
CORS_EXTRA_ORIGINS=


# =============================================================
# BMS vs SENSOR COMPARISON (all optional - defaults shown)
# =============================================================
BMS_COMPARISON_ENABLED=true
BMS_WORKER_INTERVAL_SECONDS=10
# GPS matching: calibrate with real bus data. Distances are metres (latitude AND longitude).
BMS_ENTRY_RADIUS_M=50
BMS_EXIT_RADIUS_M=70
BMS_APPROACH_RADIUS_M=300
BMS_MIN_DWELL_SECONDS=25
BMS_MIN_CONSECUTIVE_HITS=2
BMS_DEPARTURE_CONSECUTIVE_READINGS=2
# Data freshness / safety
BMS_MAX_SNAPSHOT_AGE_SECONDS=300
BMS_MAX_VALID_GAP_SECONDS=60
BMS_INITIAL_LOOKBACK_SECONDS=120
BMS_MAX_SNAPSHOTS_PER_CYCLE=30
BMS_VISIT_TIMEOUT_SECONDS=900
BMS_JOURNEY_MAX_IDLE_HOURS=24
# true = a stop may be skipped (stored as INCOMPLETE); false = strict order 1,2,3,4,5
BMS_ALLOW_SKIPPED_STOPS=true
BMS_MAX_PARALLEL_VEHICLES=4
